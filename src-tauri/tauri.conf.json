{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SEAM Share",
  "version": "0.1.0",
  "identifier": "ir.redlighte.seamshare",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SEAM Share",
        "width": 1180,
        "height": 820,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "shortDescription": "Fast private file transfer between Android and Windows",
    "longDescription": "SEAM Share moves files directly between nearby Android and Windows devices over the local network.",
    "category": "Utility"
  }
}
